# Database connection strings (use direct Neon connections, not pooler)
DATABASE_URL=postgres://user:password@ep-sample-pool.region.aws.neon.tech/sutra_mini?sslmode=require
TEST_DATABASE_URL=postgres://user:password@ep-sample-pool.region.aws.neon.tech/sutra_mini_test?sslmode=require

# HTTP API server
API_ADDR=:8080
API_URL=http://localhost:8080

# Mock accounting server
MOCK_ADDR=:8081
MOCK_URL=http://localhost:8081
ERROR_RATE=0.20
HANG_RATE=0.10
HANG_DURATION=5s

# Sync worker configuration
MAX_ATTEMPTS=5
BACKOFF_BASE=2s
BACKOFF_JITTER=0.2
HTTP_TIMEOUT=3s
LEASE=15s
POLL_INTERVAL=1s
CONCURRENCY=5
